{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-login.php",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/humanmade/two-factor/archive/refs/heads/master.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "two-factor-passkey/plugin.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; wp_insert_user( [ 'user_login' => 'editor', 'user_pass' => 'password', 'user_email' => 'editor@example.com', 'role' => 'editor' ] ); $admin = get_user_by( 'login', 'admin' ); update_user_meta( $admin->ID, '_two_factor_backup_codes', [ wp_hash_password( '12345678' ) ] );"
		}
	]
}
